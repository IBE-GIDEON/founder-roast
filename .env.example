# ── Required for launch ───────────────────────────────────────────────
# Public URL of the site. Used for PayPal return links, share links and the watermark.
# Optional on Vercel: falls back to the project's production URL.
NEXT_PUBLIC_SITE_URL=https://founderroast.com

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
# Optional: override the models. The fallback is used if the main model errors.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# PayPal REST app (https://developer.paypal.com/dashboard/applications).
# Start with a Sandbox app + PAYPAL_ENV=sandbox, then switch to a Live app + PAYPAL_ENV=live.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Price of the full report in cents (3900 = $39)
PRICE_CENTS=3900
# Price of a fix check in cents (1500 = $15). Half is refunded automatically when everything is fixed.
RECHECK_PRICE_CENTS=1500

# Storage: Upstash Redis REST (Vercel Marketplace → Upstash sets KV_REST_API_URL / KV_REST_API_TOKEN for you)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Long random string. Signs private report links. Generate with: openssl rand -hex 32
ACCESS_SECRET=

# ── Optional ──────────────────────────────────────────────────────────
# Lets scripts/batch-roast.mjs skip the per-IP rate limit.
ADMIN_KEY=
# Free roasts allowed per IP per hour.
RATE_LIMIT_PER_HOUR=5
# Your X handle without @ (footer link + "via @you" in share text).
NEXT_PUBLIC_X_HANDLE=
# Support address (where mail goes) and the label shown on the site instead of the raw address.
NEXT_PUBLIC_CONTACT_EMAIL=prevearchiveapp@gmail.com
NEXT_PUBLIC_CONTACT_LABEL=founderroast.support
# Resend (https://resend.com) — emails buyers their private report link after payment.
RESEND_API_KEY=
EMAIL_FROM="Founder Roast <reports@founderroast.com>"
# Jina Reader key — used only as a fallback for JavaScript-rendered sites (works without a key at low volume).
JINA_API_KEY=
# DNS servers used when the system resolver fails (comma-separated).
DNS_FALLBACK_SERVERS=1.1.1.1,8.8.8.8
