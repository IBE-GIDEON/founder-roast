# ── Required for launch ───────────────────────────────────────────────
# Public URL of the site. Used for payment return links, share links and the watermark.
# Optional on Vercel: falls back to the project's production URL.
NEXT_PUBLIC_SITE_URL=https://founderroast.com

# Groq (https://console.groq.com/keys). The free tier works: each model has its own
# 1,000 requests/day and 8,000 tokens/minute, so a roast spreads across three models.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_STRATEGY_MODEL=qwen/qwen3.8-27b
# Optional free backup provider (any OpenAI-compatible API), used when Groq is busy. E.g. Cerebras free tier:
# EXTRA_LLM_URL=https://api.cerebras.ai/v1/chat/completions
# EXTRA_LLM_MODEL=gpt-oss-120b
EXTRA_LLM_URL=
EXTRA_LLM_KEY=
EXTRA_LLM_MODEL=

# Paystack (https://dashboard.paystack.com/#/settings/developers). Use sk_test_… while testing, sk_live_… when live.
# Webhook URL to set in Paystack: https://YOUR_DOMAIN/api/paystack/webhook
PAYSTACK_SECRET_KEY=
# Currency your Paystack account accepts: USD (must be enabled on the account), NGN, GHS, ZAR or KES.
# Prices below are in that currency's smallest unit (cents / kobo).
PAYSTACK_CURRENCY=USD
# Price of the full report in cents (3900 = $39)
PRICE_CENTS=3900
# Price of a fix check in cents (1500 = $15). Half is refunded automatically when everything is fixed.
RECHECK_PRICE_CENTS=1500

# Storage: Upstash Redis REST (Vercel Marketplace → Upstash sets KV_REST_API_URL / KV_REST_API_TOKEN for you)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Long random string. Signs private report links. Generate with: openssl rand -hex 32
ACCESS_SECRET=

# ── Optional ──────────────────────────────────────────────────────────
# Lets scripts/batch-roast.mjs skip the per-IP rate limit.
ADMIN_KEY=
# Free roasts allowed per IP per hour.
RATE_LIMIT_PER_HOUR=5
# Your X handle without @ (footer link + "via @you" in share text).
NEXT_PUBLIC_X_HANDLE=
# Support address (where mail goes) and the label shown on the site instead of the raw address.
NEXT_PUBLIC_CONTACT_EMAIL=prevearchiveapp@gmail.com
NEXT_PUBLIC_CONTACT_LABEL=founderroast.support
# Emails buyers their private report link after payment.
# Free: Gmail. Turn on 2-Step Verification, then create an app password at https://myaccount.google.com/apppasswords
SMTP_USER=
SMTP_PASS=
# Or Resend (needs your own domain to email customers):
RESEND_API_KEY=
EMAIL_FROM="Founder Roast <reports@founderroast.com>"
# Jina Reader key — used only as a fallback for JavaScript-rendered sites (works without a key at low volume).
JINA_API_KEY=
# DNS servers used when the system resolver fails (comma-separated).
DNS_FALLBACK_SERVERS=1.1.1.1,8.8.8.8
